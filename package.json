{
  "name": "f_record",
  "version": "4.10.0",
  "description": "一款用来录制绘画过程的轻量级PS插件。A lightweight Photoshop plugin that records your drawing process.",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/build.mjs --tests && node --experimental-test-module-mocks --test --test-timeout=60000 \"test/*.test.mjs\" \"test/panel/*.test.mjs\"",
    "check": "npm run typecheck && npm run coverage:identity",
    "test:only": "node --experimental-test-module-mocks --test --test-timeout=60000 \"test/*.test.mjs\" \"test/panel/*.test.mjs\"",
    "coverage": "npm run coverage:core && npm run coverage:panel",
    "coverage:core": "node scripts/build.mjs --tests && node --experimental-test-module-mocks --test --test-timeout=60000 --experimental-test-coverage --test-coverage-include=dist/modules/*.mjs --test-coverage-exclude=dist/modules/{app,main,ui,dashboard,sessionsView,settingsView,exportDialog,packDialog,review,watermark}.mjs \"test/*.test.mjs\"",
    "coverage:panel": "node scripts/build.mjs --tests && node --experimental-test-module-mocks --test --test-timeout=60000 --experimental-test-coverage --test-coverage-include=dist/modules/{app,main,ui,dashboard,sessionsView,settingsView,exportDialog,packDialog,review,watermark}.mjs \"test/panel/*.test.mjs\"",
    "coverage:identity": "npm run coverage:identity:core && npm run coverage:identity:panel",
    "coverage:identity:core": "node scripts/build.mjs --tests && node --experimental-test-module-mocks --test --test-timeout=60000 --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-include=dist/modules/*.mjs --test-coverage-exclude=dist/modules/{app,main,ui,dashboard,sessionsView,settingsView,exportDialog,packDialog,review,watermark}.mjs \"test/*.test.mjs\"",
    "coverage:identity:panel": "node scripts/build.mjs --tests && node --experimental-test-module-mocks --test --test-timeout=60000 --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-include=dist/modules/{app,main,ui,dashboard,sessionsView,settingsView,exportDialog,packDialog,review,watermark}.mjs \"test/panel/*.test.mjs\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lxapgjryzc/F_Record.git"
  },
  "author": "F_know",
  "license": "GPL-3.0-only",
  "bugs": {
    "url": "https://github.com/lxapgjryzc/F_Record/issues"
  },
  "homepage": "https://github.com/lxapgjryzc/F_Record#readme",
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "preact": "^10.19.3"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "esbuild": "^0.20.2",
    "typescript": "^5.4.5"
  }
}
