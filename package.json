{
  "name": "f_record",
  "version": "4.1.2",
  "description": "一款用来录制绘画过程的轻量级PS插件。A lightweight Photoshop plugin that records your drawing process.",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/build.mjs --tests && node --test \"test/*.test.mjs\"",
    "check": "npm run typecheck && npm test",
    "test:only": "node --test \"test/*.test.mjs\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lxapgjryzc/F_Record.git"
  },
  "author": "F_know",
  "license": "GPL-3.0-only",
  "bugs": {
    "url": "https://github.com/lxapgjryzc/F_Record/issues"
  },
  "homepage": "https://github.com/lxapgjryzc/F_Record#readme",
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "preact": "^10.19.3"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "esbuild": "^0.20.2",
    "typescript": "^5.4.5"
  }
}
